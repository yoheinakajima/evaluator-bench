{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "assessment",
 "type": "object",
 "required": [
  "evaluator",
  "dimension",
  "value",
  "anchor",
  "signals",
  "rationale",
  "assessed"
 ],
 "additionalProperties": false,
 "properties": {
  "evaluator": {
   "type": "string"
  },
  "dimension": {
   "enum": [
    "F",
    "G",
    "P",
    "A",
    "S",
    "R",
    "M",
    "X"
   ]
  },
  "value": {
   "type": "integer",
   "minimum": 0,
   "maximum": 4
  },
  "anchor": {
   "type": "integer",
   "minimum": 0,
   "maximum": 4
  },
  "signals": {
   "type": "array",
   "items": {
    "type": "string"
   },
   "minItems": 1
  },
  "rationale": {
   "type": "string"
  },
  "assessed": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "assessor": {
   "type": "string"
  },
  "open_questions": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "evidence_limited": {
   "type": "boolean"
  }
 }
}
